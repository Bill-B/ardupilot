<?xml version="1.0"?>
<!--
************************************************************************
Rascal 110 R/C airplane config. This files ties together all the components
used by FGFS to represent the Rascal 110 (by Sig Mfg) including the flight
dynamics model, and external 3D model.
************************************************************************
-->

<PropertyList>
 <sim>

  <description>CREATeV FTV</description>
  <author>RAALF</author>
  <aircraft-version>1</aircraft-version>
  <model-hz>400</model-hz>

  <startup>
    <splash-texture>Aircraft/CREATeV/splash.png</splash-texture>
  </startup>

  <flight-model>jsb</flight-model>
  <aero>CREATeV</aero>
  <fuel-fraction>0.8</fuel-fraction>

  <systems>
   <autopilot>
    <path>Aircraft/CREATeV/Systems/FTV-autopilot.xml</path>
   </autopilot>
   <electrical>
    <path>Aircraft/CREATeV/Systems/electrical.xml</path>
   </electrical>
  </systems>

  <sound>
   <path>Aircraft/Generic/generic-sound.xml</path>
  </sound>

  <panel>
   <visibility archive="n">false</visibility>
  </panel>

  <model>
   <path archive="y">Aircraft/CREATeV/Models/Rascal110.xml</path>
  </model>

  <!--<view>
   <internal archive="y">true</internal>
   <config>
     <x-offset-m archive="y">0.0</x-offset-m>
     <y-offset-m archive="y">-0.15</y-offset-m>
     <z-offset-m archive="y">0.9</z-offset-m>
     <pitch-offset-deg>0</pitch-offset-deg>
   </config>
  </view>-->
  <view>
   <name>Cockpit View</name>
   <type>lookfrom</type>
   <internal type="bool">true</internal>
   <config>
     <from-model type="bool">true</from-model>
     <from-model-idx type="int">0</from-model-idx>
	 <default-field-of-view-deg type="double">94.0</default-field-of-view-deg>
     <x-offset-m type="double">-0.2</x-offset-m> <!-- actually y-->
     <y-offset-m type="double">0.22</y-offset-m> <!--actually z-->
     <z-offset-m type="double">1.45s</z-offset-m> <!-- acutally x-->	 
   </config>
 </view>
 

  <somepath>
	<ground-observer-lon-deg>-79.3210664</ground-observer-lon-deg>
	<ground-observer-lat-deg>43.9533747</ground-observer-lat-deg>
	<ground-observer-alt-ft>838</ground-observer-alt-ft>
  </somepath>

  <view>
    <name>Pilot View</name>
    <type>lookat</type>
    <config>
      <eye-lat-deg-path>sim/somepath/ground-observer-lat-deg</eye-lat-deg-path>
      <eye-lon-deg-path>sim/somepath/ground-observer-lon-deg</eye-lon-deg-path>
      <eye-alt-ft-path>sim/somepath/ground-observer-alt-ft</eye-alt-ft-path>
	  <eye-roll-deg-path>/sim/tower/roll-deg</eye-roll-deg-path>
	  <eye-pitch-deg-path>/sim/tower/pitch-deg</eye-pitch-deg-path>
	  <eye-heading-deg-path>/sim/tower/heading-deg</eye-heading-deg-path>
	   
      <at-model type="bool">true</at-model>
      <at-model-idx type="int">0</at-model-idx>
	  
	  <ground-level-nearplane-m type="double">10.0f</ground-level-nearplane-m>
    </config>
  </view>

  <submodels>
    <serviceable type="bool">1</serviceable>
    <path>Aircraft/CREATeV/CREATeV-submodels.xml</path>
  </submodels>

  <!--<view n="1">
   <config>
    <target-z-offset-m archive="y" type="double">0.5</target-z-offset-m>
   </config>
  </view>-->

  <view n="2">
   <config>
    <target-z-offset-m archive="y" type="double">0.5</target-z-offset-m>
   </config>
  </view>

  <view n="3">
   <config>
    <target-z-offset-m archive="y" type="double">0.5</target-z-offset-m>
   </config>
  </view>

  <view n="4">
   <config>
    <target-z-offset-m archive="y" type="double">0.5</target-z-offset-m>
   </config>
  </view>

  <view n="5">
   <config>
    <target-z-offset-m archive="y" type="double">0.5</target-z-offset-m>
   </config>
  </view>

  <view n="6">
   <config>
    <target-z-offset-m archive="y" type="double">0.5</target-z-offset-m>
   </config>
  </view>

  <multiplay>
    <chat_display>1</chat_display>
    <generic>
      <int type="bool">0</int>  <!-- smoke -->
      <int type="bool">0</int>  <!-- trajectory markers -->
    </generic>
  </multiplay>

  <help>
    <title>CREATeV (Sig Mfg)</title>
    <line>Cruise speed: 10m/s</line>
    <line>Never-exceed (Vne): 20m/s</line>
    <line>Best Glide (Vglide): 10m/s</line>
    <line>Maneuvering (Va): 12m/s</line>
    <line>Approach speed: 10m/s kts</line>
    <line>Stall speed (Vs): 7m/s kts</line>
  </help>

 </sim>

 <nasal>
  <CREATeV>
   <file>Aircraft/CREATeV/Systems/main.nas</file>
   <file>Aircraft/CREATeV/Systems/airdata.nas</file>
   <file>Aircraft/CREATeV/Systems/ugear.nas</file>
      <script>
         setlistener("/sim/signals/fdm-initialized", func {
             var left  = screen.display.new(20, 10);
             left.add("/apm/aileron");
             left.add("/apm/elevator");
             left.add("/apm/rudder");
             left.add("/apm/throttle");

             var right = screen.display.new(-250, 20);
             right.add("/apm/pitch");
             right.add("/apm/roll");
             right.add("/apm/altitude");
             right.add("/apm/heading");
             right.add("/apm/airspeed");
             right.add("/apm/groundspeed");
         });
        </script>
  </CREATeV>
 </nasal>

 <yasim>
  <Rascal110>
   <pilot-lb>2</pilot-lb>
  </Rascal110>
 </yasim>

 <input>
   <keyboard include="Rascal-keyboard.xml"/>
 </input>

 <controls>
  <flight>
   <aileron-trim>-0.01</aileron-trim>   <!-- fixed -->
   <elevator-trim>0.00</elevator-trim> <!-- controllable -->
   <rudder-trim>0.00</rudder-trim>     <!-- fixed -->
  </flight>
  <engines>
   <engine n="0">
    <magnetos>3</magnetos>
   </engine>
  </engines>
  <smoke alias="/sim/multiplay/generic/int[0]"/>
  <trajectory-markers alias="/sim/multiplay/generic/int[1]"/>
 </controls>

 <engines>
  <engine>
   <rpm type="double">700</rpm>
  </engine>
 </engines>

</PropertyList>
